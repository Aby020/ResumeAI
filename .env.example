# ResumeAI — environment template.
# Copy this file to `.env` and fill in real values before running the app.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# NEVER commit the real `.env` file — it is gitignored.

# ── Django ────────────────────────────────────────────────────────────────
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production.
DEBUG=True

# Comma-separated hostnames allowed to serve the app.
# On Render (RENDER=true) the app's own hostname and *.onrender.com are
# appended automatically, so fresh deploys work before this is configured.
ALLOWED_HOSTS=127.0.0.1,localhost

# Exact frontend origin(s) allowed to call the JSON API (CORS).
# Development defaults are same-origin via the Vite proxy, so leave blank in
# dev. In production set the exact deployed frontend origin(s), e.g.
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=

# Origins allowed for CSRF (HTTPS production hosts only), e.g.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Used for password reset. Gmail example values shown.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── Cloudinary (media storage) ──────────────────────────────────────────────
# Required on Render (production) for user-uploaded media. The app falls back to
# local file storage if any of these are missing, but media will be lost on
# Render's ephemeral filesystem. Find these in your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI / OpenAI (optional) ────────────────────────────────────────────────
# Enables AI-powered explanations and rewrite suggestions.
# Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini   # default; change for different cost/capability
# DEBUG_AI — returns mock AI data when a real call fails. Development only:
# NEVER set this in production. If unset it follows DEBUG (off in production).

# ── Database ──────────────────────────────────────────────────────────────
# Optional. Defaults to a local SQLite file (db.sqlite3). For production use
# a DATABASE_URL, e.g. a Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
