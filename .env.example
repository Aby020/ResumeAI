# ResumeAI — environment template.
# Copy this file to `.env` and fill in real values before running the app.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# NEVER commit the real `.env` file — it is gitignored.

# ── Django ────────────────────────────────────────────────────────────────
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production.
DEBUG=True

# Comma-separated hostnames allowed to serve the app.
ALLOWED_HOSTS=127.0.0.1,localhost

# Origins allowed for CSRF (HTTPS production hosts only), e.g.
# CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────
# Used for password reset. Gmail example values shown.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── Cloudinary (media storage) ──────────────────────────────────────────────
# Required on Render (production) for user-uploaded media. The app falls back to
# local file storage if any of these are missing, but media will be lost on
# Render's ephemeral filesystem. Find these in your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── AI / OpenAI (optional) ────────────────────────────────────────────────
# Enables AI-powered explanations and rewrite suggestions.
# Get a key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini   # default; change for different cost/capability

# ── Database ──────────────────────────────────────────────────────────────
# Optional. Defaults to a local SQLite file (db.sqlite3). For production use
# a DATABASE_URL, e.g. postgres://user:pass@host:5432/dbname
# DATABASE_URL=postgres://user:pass@host:5432/dbname
